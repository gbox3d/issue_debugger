PORT=8080

# 활성 LLM provider (openai | anthropic)
LLM_PROVIDER=anthropic

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=60000

# Anthropic (CLAUDE_API_KEY 도 alias 로 인식됨)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=60000
# thinking + JSON 출력 전체의 한도
ANTHROPIC_MAX_TOKENS=8192

# 일반 팩트체크: 원문 스냅샷과 보고서 저장 위치 (Git 제외)
GENERAL_DATA_DIR=./data/verification

# 인사 시점 검증: 공식 원문 스냅샷과 개별 보고서 저장 위치 (Git 제외)
PERSONNEL_DATA_DIR=./data/personnel

# RAG (기존 경로용 local trusted db json; 현재 일반 API 필수 seed 아님)
TRUSTED_DB_PATH=./src/services/rag/sample_trusted_db.json
TRUSTED_DB_TOPK=5

# Web search (Tavily) — 일반/영문 fallback
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
# 일반 수집기는 호출별 개수를 별도 지정하며 아래는 검색 래퍼의 기본값
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000
WEB_RECENCY_DAYS=365

# 네이버 검색 API — 한국어 뉴스(발행일 포함, 관련도순 sort=sim). 일반 수집기에서 사용.
# developers.naver.com → 애플리케이션 등록 → 사용 API '검색'
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_MAX_RESULTS=15

# 검증 파이프라인 성능 튜닝
# CLAIM_CONCURRENCY: 동시에 처리할 주장 수(코드에서 1~4로 제한).
# 적격 주장당 기본 B/D 2회, 선택 분석 A/C 추가 최대 2회; 주장 추출 호출은 별도.
# 검색은 주장별 제공자 호출 예산이 있으므로 실제 호출 수는 캐시·자료·질의에 따라 달라짐.
# CLAIM_MAX: 현재 일반 API의 실제 상한은 min(3, CLAIM_MAX). 초과 주장은 미검증으로 표시.
CLAIM_CONCURRENCY=4
CLAIM_MAX=12

# URL 크롤러 (SSRF-safe). 내부/사설 주소는 코드에서 차단됨.
CRAWL_ENABLED=true
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_BYTES=3000000
CRAWL_MAX_TEXT_CHARS=20000
CRAWL_MAX_REDIRECTS=3
